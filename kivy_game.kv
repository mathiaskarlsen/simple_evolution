<Bomb>:
    text: ""
    background_color: self.color
    canvas.before:
        Color:
            rgba: self.color
        Rectangle:
            size: self.size
            pos: self.pos
<Player@Label>:
    text: "yoooo"
    text_size: 32, 48
    font_size: 12
    outline_color: (0, 0, 0, 1)
    outline_width: 1
    background_color: self.color
    canvas.before:
        Color:
            rgba: self.color
        Rectangle:
            size: self.size
            pos: self.pos
<Food>:
    text: ""
    background_color: self.color
    canvas.before:
        Color:
            rgba: self.color
        Rectangle:
            size: self.size
            pos: self.pos
<MyLayout>
    FloatLayout:
        id: FL
